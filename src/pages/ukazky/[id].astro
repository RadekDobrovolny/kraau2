---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareControl from '../../components/ShareControl.astro';
import ExampleCard from '../../components/ExampleCard.astro';
import Icon from '../../components/Icon.astro';
import { repository } from '../../lib/repository';
import type { Example } from '../../lib/schema';
import { withBase, criterionUrl, displayTitle } from '../../lib/urls';
import { typeLabels } from '../../data/editorial';
export function getStaticPaths() {
  return repository
    .listExamples()
    .map((example) => ({ params: { id: example.publicId }, props: { example } }));
}
interface Props {
  example: Example;
}
const { example } = Astro.props;
const related = repository
  .listExamples()
  .filter((e) => e.id !== example.id && e.topics.some((t) => example.topics.includes(t)))
  .slice(0, 3);
---

<Layout title={example.title} current="ukazky" noindex={example.status === 'demo'}>
  <div class="shell">
    <Breadcrumbs
      items={[{ label: 'Ukázky z praxe', href: withBase('ukazky/') }, { label: example.title }]}
    />
    <header class="page-head">
      <div class="page-head-row">
        <div>
          <p class="eyebrow">
            {typeLabels[example.type]} · {example.duration}
          </p>
          <h1>{example.title}</h1>
          <p class="lead">{example.summary}</p>
        </div>
        <ShareControl label="Kopírovat odkaz na ukázku" />
      </div>
    </header>
    {example.status === 'demo' && (
      <aside class="notice">
        <p>
          <strong>Autorská modelová ukázka.</strong> Nejde o záznam skutečné výuky. Komentované
          vazby jsou pracovní návrhy k metodickému ověření.
        </p>
      </aside>
    )}
    <section class="content-section">
      <h2>Kontext situace</h2>
      <div class="example-context">
        <span>{example.context.subject}</span>
        <span>{example.context.school}</span>
        <span>{example.context.age}</span>
      </div>
      <p class="prose">{example.context.situation}</p>
    </section>
    <section class="content-section prose">
      <h2>Čeho si všimnout</h2>
      <ul>
        {example.questions.map((q) => (
          <li>{q}</li>
        ))}
      </ul>
    </section>
    <section class="example-body" aria-label="Text modelové ukázky">
      {example.body.map((p) => (
        <section>
          <h3>{p.heading}</h3>
          <p>{p.text}</p>
        </section>
      ))}
    </section>
    <section class="content-section back-link">
      <h2>Jak ukázka souvisí s rámcem</h2>
      {example.links.map((link) => (
        <article class="evidence-link" id={`vazba-${link.id}`}>
          <p class="eyebrow">
            Pracovní komentovaná vazba ·{' '}
            {link.level === null ? 'bez přiřazení úrovně' : `úroveň ${link.level}`}
          </p>
          <h3>
            <a
              href={`${criterionUrl(link.criterionCode)}${link.level !== null ? `?uroven=${link.level}#urovne` : ''}`}
            >
              {link.criterionCode} ·{' '}
              {displayTitle(repository.getCriterion(link.criterionCode)!.title)}
            </a>
          </h3>
          <p class="evidence">
            <strong>Konkrétní důkaz:</strong> {link.evidence}
          </p>
          <p>{link.commentary}</p>
          <a class="text-link" href={`#vazba-${link.id}`}>
            Odkaz na tuto vazbu <Icon name="link" size={16} />
          </a>
        </article>
      ))}
    </section>
    <section class="content-section prose">
      <h2>Co z této ukázky nelze vyvodit</h2>
      <p>{example.limitations}</p>
    </section>
    <section class="content-section prose">
      <h2>Otázka pro vlastní praxi</h2>
      <p>
        Co by se v podobné situaci mohlo odehrát ve vaší třídě? Jaké další informace byste
        potřebovali, než byste navrhli změnu?
      </p>
      <a class="button secondary" href={withBase('jak-pracovat/dalsi-krok/')}>
        Promyslet další krok <Icon name="arrow-right" size={18} />
      </a>
    </section>
    {related.length > 0 && (
      <section class="content-section">
        <h2>Související ukázky</h2>
        <div class="examples-grid">
          {related.map((item) => (
            <ExampleCard example={item} />
          ))}
        </div>
      </section>
    )}
    <p class="source-reference">
      Autor: {example.author}. {example.rights.scope}
      <br />
      Revize: {example.revisionId}. Metodické ověření: {example.reviewedAt ?? 'dosud neproběhlo'}.
    </p>
  </div>
</Layout>
