---
import Icon from './Icon.astro';
import { withBase } from '../lib/urls';
interface Props {
  compact?: boolean;
  id?: string;
}
const { compact = false, id = 'home-search' } = Astro.props;
---

<form
  class:list={['search-box', { compact }]}
  action={withBase('hledat/')}
  method="get"
  role="search"
>
  <label for={id}>Co ve výuce řešíte?</label>
  <div class="search-input-row">
    <Icon name="search" size={23} />
    <input
      id={id}
      name="q"
      type="search"
      placeholder="Např. žáci se nezapojují nebo 4.2.2"
      maxlength="240"
    />
    <button class="button" type="submit">
      Hledat <Icon name="arrow-right" size={18} />
    </button>
  </div>
</form>
